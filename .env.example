# docker compose 변수 (모두 기본값이 있어 생략 가능)
DB_DATABASE=mktly
DB_USERNAME=mktly
DB_PASSWORD=mktly_secret
DB_ROOT_PASSWORD=root_secret

AI_INTERNAL_TOKEN=dev-internal-token
# AI 카피 공급자: Gemini(무료) -> OpenAI(유료) -> Mock 순서. 키가 있는 공급자만 쓰고, 모두 비워 두면 Mock 모드로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 호스트 포트
APP_HOST_PORT=8100
AI_HOST_PORT=8101
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
MAILPIT_UI_HOST_PORT=8125
MAILPIT_SMTP_HOST_PORT=1125
