# docker compose 변수 (모두 기본값이 있어 생략 가능)
DB_DATABASE=mktly
DB_USERNAME=mktly
DB_PASSWORD=mktly_secret
DB_ROOT_PASSWORD=root_secret

AI_INTERNAL_TOKEN=dev-internal-token
# 비워 두면 AI 서비스는 Mock 모드로 동작
ANTHROPIC_API_KEY=

# 호스트 포트
WEB_HOST_PORT=3100
API_HOST_PORT=8100
AI_HOST_PORT=8101
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
MAILPIT_UI_HOST_PORT=8125
MAILPIT_SMTP_HOST_PORT=1125
