# docker compose 변수 (모두 기본값이 있어 생략 가능)
DB_DATABASE=mktly
DB_USERNAME=mktly
DB_PASSWORD=mktly_secret
DB_ROOT_PASSWORD=root_secret

AI_INTERNAL_TOKEN=dev-internal-token
# AI 카피 공급자: Gemini(무료) -> OpenAI(유료) -> Mock 순서. 키가 있는 공급자만 쓰고, 모두 비워 두면 Mock 모드로 동작
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 임베딩(참고 자료 검색용). 키가 없으면 외부 호출 없이 로컬 해시 벡터를 쓴다.
GEMINI_EMBED_MODEL=gemini-embedding-001
OPENAI_EMBED_MODEL=text-embedding-3-small
# 카드뉴스 AI 배경 삽화(선택, 유료: 이미지 생성에는 무료 등급이 없다). backend/.env의 MKTLY_AI_IMAGE_DAILY_LIMIT을 정해야 켜진다.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 호스트 포트
APP_HOST_PORT=8100
AI_HOST_PORT=8101
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
MAILPIT_UI_HOST_PORT=8125
MAILPIT_SMTP_HOST_PORT=1125
