# syntax=docker/dockerfile:1
# 운영(Railway)용 이미지. 웹 서버, 큐 워커, 스케줄러를 한 컨테이너에서 실행한다(docker/start.sh).

# 1) 프론트 에셋 빌드
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.js ./
COPY resources resources
RUN mkdir -p public && npm run build

# 2) PHP 의존성 (개발용 패키지 제외)
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-scripts --prefer-dist --ignore-platform-reqs

# 3) 실행 이미지 (FrankenPHP = Caddy + PHP)
FROM dunglas/frankenphp:1-php8.4

RUN install-php-extensions pdo_mysql pcntl bcmath zip opcache \
    && cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

COPY docker/php-prod.ini $PHP_INI_DIR/conf.d/zz-mktly.ini
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app
COPY --from=vendor /app/vendor ./vendor
COPY . .
COPY --from=assets /app/public/build ./public/build
COPY docker/Caddyfile /etc/caddy/Caddyfile

# start.sh가 Windows 줄바꿈(CRLF)으로 들어와도 실행되도록 CR을 제거한다.
RUN tr -d '\r' < docker/start.sh > /usr/local/bin/mktly-start \
    && chmod +x /usr/local/bin/mktly-start \
    && composer dump-autoload --optimize --no-dev --no-scripts \
    && php artisan package:discover --ansi \
    && mkdir -p storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache

ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    QUEUE_CONNECTION=database \
    CACHE_STORE=database \
    SESSION_DRIVER=database \
    PORT=8080

EXPOSE 8080
CMD ["mktly-start"]
